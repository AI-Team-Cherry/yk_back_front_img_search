# Cherry Back Project - Frontend Environment
# Mock 데이터 사용 설정 (실제 AI 대신 미리 정의된 응답 사용)
REACT_APP_USE_MOCK_DATA=true

# API 설정
REACT_APP_API_URL=http://localhost:8000

# 앱 정보
REACT_APP_APP_NAME=Cherry Back Analytics Platform
REACT_APP_VERSION=1.0.0

# 기능 플래그
REACT_APP_ENABLE_ML_ANALYTICS=true
REACT_APP_ENABLE_DATA_UPLOAD=true
REACT_APP_ENABLE_NATURAL_LANGUAGE=true

# 개발 설정
REACT_APP_ENV=development
REACT_APP_DEBUG=true
GENERATE_SOURCEMAP=false